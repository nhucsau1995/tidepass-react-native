{
  "expo": {
    "name": "Tidepass",
    "slug": "tidepass",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "tidepass",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tidepass.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F9F8F7",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tidepass.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        { "image": "./assets/splash-icon.png", "imageWidth": 160, "backgroundColor": "#F9F8F7" }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
